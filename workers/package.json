{
  "name": "conecta-umadalpe-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create conecta-umadalpe-db",
    "db:migrate:local": "wrangler d1 execute conecta-umadalpe-db --local --file=../schema.sql",
    "db:migrate:remote": "wrangler d1 execute conecta-umadalpe-db --remote --file=../schema.sql",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^3.90.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "hono": "^4.6.9"
  }
}
